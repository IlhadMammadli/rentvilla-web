# Local development: use Neon (free) or any PostgreSQL database.
# SQLite (file:./dev.db) does NOT work on Netlify — use PostgreSQL in production.
#
# Neon: https://neon.tech → create project → copy connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

SESSION_SECRET="change-this-to-a-long-random-string-in-production"

# SMTP_FROM should use the same address as SMTP_USER (required for Gmail).
# SMTP_PASS = Gmail App Password with spaces removed.
# After changing env vars on Netlify, trigger a new deploy.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your@gmail.com"
# SMTP_PASS="app-password"
# SMTP_FROM="VillaHub <noreply@villahub.az>"

# Villa photos — DigitalOcean Spaces (recommended). See docs/DIGITALOCEAN-SPACES.md
# S3_ENDPOINT="https://fra1.digitaloceanspaces.com"
# S3_REGION="fra1"
# S3_BUCKET="rentvilla-uploads"
# S3_ACCESS_KEY_ID="your-spaces-access-key"
# S3_SECRET_ACCESS_KEY="your-spaces-secret-key"
# S3_PUBLIC_BASE_URL="https://rentvilla-uploads.fra1.cdn.digitaloceanspaces.com"
# NEXT_PUBLIC_S3_PUBLIC_BASE_URL="https://rentvilla-uploads.fra1.cdn.digitaloceanspaces.com"
# (uploads go through /api/uploads/direct — no Space CORS needed in browser)

# Optional legacy fallback (Cloudinary)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_UPLOAD_PRESET="unsigned-preset-name"
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="unsigned-preset-name"

# Optional: direct URL for migrations (Neon provides this separately)
# DIRECT_URL="postgresql://..."

# Public site URL (used for Payriff payment callbacks)
# NEXT_PUBLIC_SITE_URL="https://villahub.az"

# Payriff payment gateway — https://docs.payriff.com
# PAYRIFF_SECRET_KEY="your-merchant-secret-key-from-payriff-dashboard"

# Optional: override promotion prices in AZN
# PROMO_VILLA_DAILY="5"
# PROMO_VILLA_WEEKLY="25"
# PROMO_VILLA_MONTHLY="80"
# PROMO_PROFILE_DAILY="10"
# PROMO_PROFILE_WEEKLY="50"
# PROMO_PROFILE_MONTHLY="150"
