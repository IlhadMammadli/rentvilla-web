generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VILLA_OWNER
  REALTOR
}

enum PricePeriod {
  DAILY
  MONTHLY
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  villaOwnerProfile VillaOwnerProfile?
  realtorProfile    RealtorProfile?
  villas            Villa[]
}

model VillaOwnerProfile {
  id        String @id @default(cuid())
  userId    String @unique
  firstName String
  lastName  String
  phone     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RealtorProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String
  companyLogo String?
  phone       String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  villas Villa[]
}

model Facility {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  villas VillaFacility[]
}

model Villa {
  id            String      @id @default(cuid())
  userId        String
  cityId        String
  title         String
  description   String
  price         Float
  pricePeriod   PricePeriod @default(DAILY)
  guestCount    Int
  roomCount     Int
  contactName   String
  contactPhone  String
  imageUrl      String?
  latitude      Float?
  longitude     Float?
  address       String?
  isPublished   Boolean     @default(true)
  isPreview     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  city            City                 @relation(fields: [cityId], references: [id])
  facilities      VillaFacility[]
  images          VillaImage[]
  views           VillaView[]
  contactReveals  VillaContactReveal[]
}

model VillaImage {
  id        String   @id @default(cuid())
  villaId   String
  url       String
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@index([villaId])
}

model VillaView {
  id        String   @id @default(cuid())
  villaId   String
  visitorId String?
  createdAt DateTime @default(now())

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@index([villaId])
  @@index([villaId, createdAt])
}

model VillaContactReveal {
  id        String   @id @default(cuid())
  villaId   String
  visitorId String?
  createdAt DateTime @default(now())

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@index([villaId])
  @@index([villaId, createdAt])
}

model VillaFacility {
  villaId    String
  facilityId String

  villa    Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([villaId, facilityId])
}
