generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SITE_MANAGER
  VILLA_OWNER
  REALTOR
  GUEST
}

enum PricePeriod {
  DAILY
  MONTHLY
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  villaOwnerProfile VillaOwnerProfile?
  realtorProfile    RealtorProfile?
  guestProfile      GuestProfile?
  villas            Villa[]
  favorites         VillaFavorite[]
  villaReviews      VillaReview[]
}

model GuestProfile {
  id        String @id @default(cuid())
  userId    String @unique
  firstName String
  lastName  String
  phone     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VillaOwnerProfile {
  id        String @id @default(cuid())
  userId    String @unique
  firstName String
  lastName  String
  phone     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RealtorProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String
  companyLogo String?
  phone       String
  isPromoted  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  districts CityDistrict[]
  villas    Villa[]
}

model CityDistrict {
  id        String   @id @default(cuid())
  cityId    String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  city   City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  villas Villa[]

  @@unique([cityId, name])
  @@index([cityId])
}

model Facility {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  villas VillaFacility[]
}

model Villa {
  id            String      @id @default(cuid())
  postNumber    Int         @unique @default(autoincrement())
  userId        String
  cityId        String
  districtId    String?
  title         String
  description   String
  price         Float
  pricePeriod   PricePeriod @default(DAILY)
  guestCount    Int
  roomCount     Int
  contactName   String
  contactPhone  String
  imageUrl      String?
  latitude      Float?
  longitude     Float?
  address       String?
  isPublished   Boolean     @default(true)
  isPreview     Boolean     @default(false)
  isPromoted    Boolean     @default(false)
  isAFrame      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  city            City                 @relation(fields: [cityId], references: [id])
  district        CityDistrict?        @relation(fields: [districtId], references: [id], onDelete: SetNull)
  facilities      VillaFacility[]
  images          VillaImage[]
  views           VillaView[]
  contactReveals  VillaContactReveal[]
  favorites       VillaFavorite[]
  reviews         VillaReview[]
}

model VillaReview {
  id        String   @id @default(cuid())
  villaId   String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([villaId, userId])
  @@index([villaId])
  @@index([userId])
}

model VillaImage {
  id        String   @id @default(cuid())
  villaId   String
  url       String
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@index([villaId])
}

model VillaView {
  id        String   @id @default(cuid())
  villaId   String
  visitorId String?
  createdAt DateTime @default(now())

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@index([villaId])
  @@index([villaId, createdAt])
}

model VillaContactReveal {
  id        String   @id @default(cuid())
  villaId   String
  visitorId String?
  createdAt DateTime @default(now())

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@index([villaId])
  @@index([villaId, createdAt])
}

model VillaFavorite {
  id        String   @id @default(cuid())
  userId    String
  villaId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@unique([userId, villaId])
  @@index([villaId])
  @@index([userId])
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model RegistrationOtp {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  payload   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model VillaFacility {
  villaId    String
  facilityId String

  villa    Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([villaId, facilityId])
}
